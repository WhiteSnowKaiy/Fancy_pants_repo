{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",

    "types": [
      "node",
      "@wdio/globals",
      "@wdio/cucumber-framework",
      "@wdio/visual-service"
    ],

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,

    "allowImportingTsExtensions": false
  },
  "include": ["features", "wdio.conf.ts"]
}
